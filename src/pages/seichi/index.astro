    badge: '海外遠征特化',
    badgeColor: '#0891b2',
  },
  {
    group: 'hinata',
    title: '日向坂46 聖地巡礼マップ',
    subtitle: 'MV・写真集・日向ちゃんねる・ブログ等を網羅',
    author: '清水ひなた (My Maps)',
    authorType: '转载参考',
