    categories: ['シングル・アルバム', 'CD特典映像', '写真集', '日向ちゃんねる', 'メンバーブログ', '映画・ドラマ・TV'],
    highlights: ['キュン', 'One choice', '君はハニーデュー', '日向坂で会いましょう'],
    badge: '3916スポット',
    badgeColor: '#5BC2AE',
  },
  {
    group: 'keyaki',
    title: '欅坂46 ロケ地マップ (歴史アーカイブ)',
    subtitle: '2015〜2020 歴代全シングル・けやかけ・サイン会',
    author: 'fumi Diary 2号店',
    authorType: '转载参考',
    authorUrl: 'http://blog.livedoor.jp/fumichen2/',
    spotCount: 1318,
    color: '#059669',
    href: '/seichi/keyakizaka',
    avatar: 'https://images.unsplash.com/photo-1542051841857-5f90071e7989?auto=format&fit=crop&w=120&q=80',
    categories: ['全シングルPV', '雑誌', 'サイン店舗', '欅って、書けない？', 'Live・Event'],
    highlights: ['サイレントマジョリティー', '二人セゾン', '不協和音', '徳山大五郎'],
    badge: '1318スポット史料',
    badgeColor: '#059669',
  },
