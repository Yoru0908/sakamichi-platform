    title: '櫻坂46 ロケ地マップ (総合版)',
    subtitle: '歴代シングルMV・雑誌・番組・サイン会店舗',
    author: 'fumi Diary 2号店',
    authorType: '转载参考',
    authorUrl: 'http://blog.livedoor.jp/fumichen2/',
    spotCount: 548,
    color: 'var(--color-brand-sakura)',
    href: '/seichi/sakurazaka',
    avatar: 'https://livedoor.blogimg.jp/fumichen2/imgs/0/b/0b2d9f67.jpg',
    categories: ['PV・ジャケット', '雑誌', 'サイン', 'テレビ', '櫻坂46 blog'],
    highlights: ['Nobody〜I want tomorrow', 'そこさくロケ地', 'We got your back'],
    badge: '櫻坂46 総合',
    badgeColor: '#ec4899',
  },
  {
    group: 'sakura',
    title: '的野美青・山下瞳月 東京10社めぐり',
    subtitle: '三期生による東京十社神社めぐり完全追跡',
    author: 'fumi Diary 2号店',
    authorType: '转载参考',
    authorUrl: 'https://www.google.com/maps/d/viewer?mid=1EOjvzb1kdZoT-4NoJnzMx1_b6dR_UoM',
    spotCount: 210,
    color: '#f59e0b',
    href: '/seichi/tokyo10sha',
    avatar: 'https://images.unsplash.com/photo-1590559899731-a382839e5549?auto=format&fit=crop&w=120&q=80',
    categories: ['根津神社', '神田神社', '日枝神社', '赤坂氷川神社', '品川神社', '富岡八幡宮'],
    highlights: ['東京十社巡拝', '商店街グルメ', '移動経路'],
    badge: '三期生企画',
