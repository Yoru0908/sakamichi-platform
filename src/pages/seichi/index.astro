    spotCount: 97,
    hasPhotos: true,
    color: 'var(--color-brand-sakura)',
    href: '/seichi/yamakawa-ui',
    avatar: 'https://pub-6d7574c4452b41519ab8adf1541d7f9e.r2.dev/yamakawa-ui/manual/zenkoji/01_zenkoji.png',
