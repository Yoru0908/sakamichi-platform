---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SeichiMap from '@/components/seichi/SeichiMap.tsx';

const mapTitle = '櫻坂46 海外聖地巡礼マップ (OVERSEA Map)';
const geojsonUrl = '/api/seichi-data/oversea';
const fallbackGeojsonUrl = '/seichi/oversea.geojson';
---

<BaseLayout
  title={`${mapTitle} - Sakamichi Tools`}
  description="櫻坂46の海外活動・聖地巡礼マップ（CybeRiz Seiryuu (Riz) 様制作：パリ・台北・香港・LA・ソウル・マレーシア・シンガポール等）。"
  hideFooter
>
  <p class="px-4 py-2 text-sm"><a href="/seichi/guide/oversea" class="underline">ロケ地・出典・巡り方のガイド</a></p>
  <SeichiMap
    client:only="react"
    geojsonUrl={geojsonUrl}
    fallbackGeojsonUrl={fallbackGeojsonUrl}
    memberName="櫻坂46 海外活動"
    sourceReferences={['FULL of Sakurazaka46 OVERSEA Map']}
    locationCredits="CybeRiz and others"
  />
</BaseLayout>
