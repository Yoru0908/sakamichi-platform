---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SeichiMap from '@/components/seichi/SeichiMap.tsx';

const mapTitle = '日向坂46 聖地巡礼マップ';
const geojsonUrl = '/api/seichi-data/hinatazaka';
const fallbackGeojsonUrl = '/seichi/hinatazaka-all.geojson';
---

<BaseLayout
  title={`${mapTitle} - Sakamichi Tools`}
  description="日向坂46（けやき坂46）の聖地巡礼マップ（3,900スポット以上収録）。清水ひなたさん作成のマイマップを自動同期し、MV撮影地・写真集・日向ちゃんねる・ブログ等を網羅。"
  hideFooter
>
  <SeichiMap
    client:only="react"
    geojsonUrl={geojsonUrl}
    fallbackGeojsonUrl={fallbackGeojsonUrl}
    memberName="日向坂46 聖地巡礼"
  />
</BaseLayout>
