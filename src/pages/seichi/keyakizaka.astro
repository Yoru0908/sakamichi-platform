---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SeichiMap from '@/components/seichi/SeichiMap.tsx';

const mapTitle = '欅坂46 ロケ地マップ (歴史アーカイブ)';
const geojsonUrl = '/seichi/keyakizaka-all.geojson';
---

<BaseLayout
  title={`${mapTitle} - Sakamichi Tools`}
  description="欅坂46（2015〜2020）の歴代全MV（サイレントマジョリティー〜黒い羊）・雑誌・サイン・けやかけ・ブログ・イベント会場アーカイブ（1,318スポット）。"
  hideFooter
>
  <p class="px-4 py-2 text-sm"><a href="/seichi/guide/keyakizaka" class="underline">ロケ地・出典・巡り方のガイド</a></p>
  <SeichiMap client:only="react" geojsonUrl={geojsonUrl} memberName="欅坂46 歴史アーカイブ" />
</BaseLayout>
