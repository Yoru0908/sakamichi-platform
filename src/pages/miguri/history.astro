---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SoldOutHistory from '@/components/meguri/SoldOutHistory';
import { ArrowLeft, Archive } from 'lucide-astro';
import { t } from '@/i18n';
---

<BaseLayout title={t('miguri.history.page_title')} titleKey="miguri.history.page_title" description={t('miguri.history.description')} descriptionKey="miguri.history.description">
  <main class="mx-auto max-w-screen-2xl space-y-5 px-4 py-6 sm:px-6 lg:px-8">
    <header class="space-y-3">
      <a href="/miguri" class="inline-flex min-h-9 items-center gap-1 text-xs text-[var(--text-secondary)]"><ArrowLeft size={13} /> <span data-i18n="miguri.history.back">{t('miguri.history.back')}</span></a>
      <h1 class="flex items-center gap-2 text-2xl font-bold text-[var(--text-primary)]"><Archive size={24} /> <span data-i18n="miguri.history.title">{t('miguri.history.title')}</span></h1>
      <p class="text-sm text-[var(--text-tertiary)]" data-i18n="miguri.history.intro">{t('miguri.history.intro')}</p>
    </header>
    <SoldOutHistory client:load />
    <noscript data-i18n="miguri.history.noscript">{t('miguri.history.noscript')}</noscript>
  </main>
</BaseLayout>
