---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Camera, FileText, Clock, Sparkles, Wrench, ArrowRight, Ticket, MapPin } from 'lucide-astro';
import { t, type TranslationKey } from '@/i18n';

type Tool = { titleKey: TranslationKey; descKey: TranslationKey; href: string; color: string; iconIdx: number; external?: boolean };
const categories: { key: TranslationKey; tools: Tool[] }[] = [
  { key: 'tools.archive', tools: [
    { titleKey: 'nav.instagram', descKey: 'tools.instagram.description', href: '/instagram', color: 'var(--color-brand-nogi)', iconIdx: 7 },
  ] },
  { key: 'tools.seichi', tools: [
    { titleKey: 'tools.seichi.title', descKey: 'tools.seichi.description', href: '/seichi', color: 'var(--color-brand-sakura)', iconIdx: 6 },
  ] },
  { key: 'tools.tickets', tools: [
    { titleKey: 'nav.tools.ticket_form', descKey: 'tools.tickets.description', href: 'https://chromewebstore.google.com/detail/%E5%9D%82%E9%81%93%E3%83%81%E3%82%B1%E3%83%83%E3%83%88%E4%B8%80%E9%94%AE%E5%A1%AB%E5%86%99/ghhhepiljinhplblcgalalafpagddhmp?authuser=0&hl=ja', color: 'var(--color-brand-sakura)', iconIdx: 5, external: true },
  ] },
  { key: 'tools.subtitles', tools: [
    { titleKey: 'tools.merge.title', descKey: 'tools.merge.description', href: '/tools/subtitle-merge', color: 'var(--color-brand-nogi)', iconIdx: 2 },
    { titleKey: 'nav.tools.srt_fixer', descKey: 'tools.srt.description', href: '/tools/srt-fixer', color: 'var(--color-brand-nogi)', iconIdx: 3 },
    { titleKey: 'nav.tools.fad_effect', descKey: 'tools.fad.description', href: '/tools/fad-effect', color: 'var(--color-brand-nogi)', iconIdx: 4 },
  ] },
];
---

<BaseLayout title={t('tools.page_title')} titleKey="tools.page_title" description={t('tools.description')} descriptionKey="tools.description">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
      <div class="flex items-center gap-2 mb-1">
        <Wrench size={16} class="text-[var(--text-tertiary)]" />
        <h1 class="text-2xl font-bold text-[var(--text-primary)]" data-i18n="tools.title">{t('tools.title')}</h1>
      </div>
      <p class="text-sm text-[var(--text-tertiary)]" data-i18n="tools.description">{t('tools.description')}</p>
    </div>
    {categories.map((category) => (
      <section class="mb-8">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-[var(--text-tertiary)] mb-3" data-i18n={category.key}>{t(category.key)}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {category.tools.map((tool) => (
            <a href={tool.href} target={tool.external ? '_blank' : undefined} rel={tool.external ? 'noopener noreferrer' : undefined}
              class="group relative flex flex-col p-5 rounded-xl border border-[var(--border-primary)] bg-[var(--bg-primary)] hover:-translate-y-0.5 hover:shadow-md hover:border-[var(--border-secondary)] transition-all duration-200">
              <div class="flex items-start justify-between mb-3">
                <div class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0" style={`background: color-mix(in srgb, ${tool.color} 12%, transparent); color: ${tool.color};`}>
                  {tool.iconIdx === 7 && <Camera size={18} />}
                  {tool.iconIdx === 6 && <MapPin size={18} />}
                  {tool.iconIdx === 5 && <Ticket size={18} />}
                  {tool.iconIdx === 2 && <FileText size={18} />}
                  {tool.iconIdx === 3 && <Clock size={18} />}
                  {tool.iconIdx === 4 && <Sparkles size={18} />}
                </div>
                <ArrowRight size={14} class="text-[var(--text-tertiary)] opacity-0 group-hover:opacity-100 transition-opacity mt-1" />
              </div>
              <h3 class="text-sm font-semibold text-[var(--text-primary)] mb-1" data-i18n={tool.titleKey}>{t(tool.titleKey)}</h3>
              <p class="text-xs text-[var(--text-tertiary)] leading-relaxed flex-1" data-i18n={tool.descKey}>{t(tool.descKey)}</p>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
