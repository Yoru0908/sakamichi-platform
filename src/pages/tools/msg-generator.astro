---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MsgGenerator from '@/components/messages/MsgGenerator';
import { MessageSquare, ArrowLeft } from 'lucide-astro';
import { t } from '@/i18n';
---

<BaseLayout title={t('tools.msg.page_title')} titleKey="tools.msg.page_title" description={t('tools.msg.description')} descriptionKey="tools.msg.description">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-6">
      <a href="/tools" class="inline-flex items-center gap-1 text-xs text-[var(--text-tertiary)] hover:text-[var(--color-brand-nogi)] transition-colors mb-3">
        <ArrowLeft size={12} /> <span data-i18n="tools.title">{t('tools.title')}</span>
      </a>
      <div class="flex items-center gap-2">
        <div class="w-9 h-9 rounded-lg flex items-center justify-center" style="background: color-mix(in srgb, var(--color-brand-hinata) 12%, transparent); color: var(--color-brand-hinata);">
          <MessageSquare size={18} />
        </div>
        <div>
          <h1 class="text-xl font-bold text-[var(--text-primary)]" data-i18n="nav.tools.msg_generator">{t('nav.tools.msg_generator')}</h1>
          <p class="text-xs text-[var(--text-tertiary)]" data-i18n="tools.msg.description">{t('tools.msg.description')}</p>
        </div>
      </div>
    </div>

    <!-- Native MSG Generator -->
    <MsgGenerator client:load />
  </div>
</BaseLayout>
