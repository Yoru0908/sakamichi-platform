---
import { FOOTER_CONTENT_LINKS, FOOTER_COMMUNITY_LINKS, FOOTER_TOOL_LINKS, FOOTER_HELP_LINKS } from '@/utils/navigation';
import { t } from '@/i18n';

const year = new Date().getFullYear().toString();
const reloadHrefs = new Set(['/blog', '/repo']);
const columns = [
  { key: 'footer.col.content' as const, links: FOOTER_CONTENT_LINKS },
  { key: 'footer.col.community' as const, links: [...FOOTER_COMMUNITY_LINKS, ...FOOTER_TOOL_LINKS] },
  { key: 'footer.col.help' as const, links: FOOTER_HELP_LINKS },
];
---

<footer class="border-t border-[var(--border-primary)] bg-[var(--bg-secondary)] mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="text-lg font-bold text-[var(--text-primary)]">Sakamichi Tools</a>
        <p class="mt-3 text-sm text-[var(--text-tertiary)] leading-relaxed" data-i18n="footer.description">{t('footer.description')}</p>
      </div>
      {columns.map((column) => (
        <div>
          <h4 class="text-xs font-semibold text-[var(--text-tertiary)] uppercase tracking-wider mb-4" data-i18n={column.key}>{t(column.key)}</h4>
          <ul class="space-y-2.5">
            {column.links.map((link) => (
              <li>
                <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}
                  {...(reloadHrefs.has(link.href) ? { 'data-astro-reload': true } : {})}
                  class="text-sm text-[var(--text-secondary)] hover:text-[var(--color-brand-nogi)] transition-colors">
                  <span data-i18n={link.labelKey}>{t(link.labelKey)}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="border-t border-[var(--border-primary)] mt-10 pt-8">
      <p class="text-xs text-[var(--text-tertiary)] leading-relaxed max-w-3xl" data-i18n="footer.disclaimer">{t('footer.disclaimer')}</p>
      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-[var(--text-tertiary)]">
        <span data-i18n="footer.copyright" data-i18n-params={JSON.stringify({ year })}>{t('footer.copyright', 'zh', { year })}</span>
        <span class="hidden sm:inline">·</span>
        <span data-i18n="footer.summary">{t('footer.summary')}</span>
        <a href="/privacy" class="underline hover:text-[var(--text-secondary)]" data-i18n="footer.privacy">{t('footer.privacy')}</a>
        <a href="/terms" class="underline hover:text-[var(--text-secondary)]" data-i18n="footer.terms">{t('footer.terms')}</a>
      </div>
    </div>
  </div>
</footer>
