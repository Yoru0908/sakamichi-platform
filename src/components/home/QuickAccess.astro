---
import { Pen, Radio, Image, Calendar, Mic, Wrench, Cake, Activity } from 'lucide-astro';
import { t, type TranslationKey } from '@/i18n';

const items: { key: TranslationKey; href: string; icon: string; color: string }[] = [
  { key: 'nav.blog', href: '/blog', icon: 'pen', color: 'var(--color-brand-nogi)' },
  { key: 'nav.radio', href: '/radio', icon: 'radio', color: 'var(--color-brand-sakura)' },
  { key: 'nav.photocard', href: '/photocard', icon: 'image', color: 'var(--color-brand-sakura)' },
  { key: 'nav.birthdays', href: '/birthday-cards', icon: 'cake', color: 'var(--color-brand-sakura)' },
  { key: 'nav.miguri.manage', href: '/miguri', icon: 'calendar', color: 'var(--color-brand-hinata)' },
  { key: 'nav.miguri.queue', href: '/miguri/queue', icon: 'activity', color: 'var(--color-brand-hinata)' },
  { key: 'nav.repo', href: '/repo', icon: 'mic', color: 'var(--color-brand-sakura)' },
  { key: 'nav.tools', href: '/tools', icon: 'wrench', color: 'var(--text-tertiary)' },
];

const reloadHrefs = new Set(['/blog', '/repo']);
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
  <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3">
    {items.map((item) => (
      <a
        href={item.href}
        {...(reloadHrefs.has(item.href) ? { 'data-astro-reload': true } : {})}
        class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-[var(--text-secondary)] bg-[var(--bg-secondary)] hover:bg-[var(--bg-tertiary)] transition-colors duration-200"
      >
        <span style={`color: ${item.color};`}>
          {item.icon === 'pen' && <Pen size={13} />}
          {item.icon === 'radio' && <Radio size={13} />}
          {item.icon === 'image' && <Image size={13} />}
          {item.icon === 'cake' && <Cake size={13} />}
          {item.icon === 'calendar' && <Calendar size={13} />}
          {item.icon === 'activity' && <Activity size={13} />}
          {item.icon === 'mic' && <Mic size={13} />}
          {item.icon === 'wrench' && <Wrench size={13} />}
        </span>
        <span data-i18n={item.key}>{t(item.key)}</span>
      </a>
    ))}
  </div>
</section>
