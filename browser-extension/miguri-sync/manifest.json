{
  "manifest_version": 3,
  "name": "46log 咪咕力同步",
  "version": "1.2.0",
  "description": "46logの履歴同期と坂ログの櫻坂46応募結果読み込み。坂ログでは内容確認後に保存し、統計協力は別途同意。", 
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://46log.com/*",
    "https://saka46log.com/*",
    "https://api.46log.com/*",
    "https://fortunemusic.jp/*",
    "https://ticket.fortunemeets.app/*",
    "https://ticket-api.fortunemeets.app/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://46log.com/miguri*", "https://saka46log.com/import*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://fortunemusic.jp/*",
        "https://ticket.fortunemeets.app/*"
      ],
      "js": ["official.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "46log 咪咕力同步",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
