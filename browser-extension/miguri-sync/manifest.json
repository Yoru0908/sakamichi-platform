{
  "manifest_version": 3,
  "name": "46log 咪咕力同步",
  "version": "1.1.17",
  "description": "读取 forTUNE music 履历；支持 46log 和坂ログ。" ,
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://46log.com/*",
    "https://saka46log.com/*",
    "https://api.46log.com/*",
    "https://fortunemusic.jp/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://46log.com/*", "https://saka46log.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://fortunemusic.jp/*"],
      "js": ["official.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "46log 咪咕力同步",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
